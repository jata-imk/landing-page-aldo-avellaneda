# ==================================
# CONFIGURACIÓN SMTP PARA PHPMAILER
# ==================================

# Servidor SMTP del hosting
# Consultar en el panel de control (cPanel, Plesk, etc.)
SMTP_HOST=mail.tudominio.com

# Puerto SMTP
# Usualmente 587 (TLS) o 465 (SSL)
SMTP_PORT=587

# Tipo de encriptación
# tls - Para puerto 587 (recomendado)
# ssl - Para puerto 465
SMTP_ENCRYPTION=tls

# Credenciales de autenticación
# Usuario: generalmente un email completo
SMTP_USERNAME=noreply@tudominio.com

# Contraseña: contraseña del email configurado arriba
SMTP_PASSWORD=tu-contraseña-aqui

# ==================================
# CONFIGURACIÓN DE REMITENTE Y DESTINATARIOS
# ==================================

# Email del remitente (FROM) - De quién sale el email
MAIL_FROM_ADDRESS=noreply@tudominio.com
MAIL_FROM_NAME="Dr. Aldo Avellaneda - Sistema de Citas"

# Email del destinatario (TO) - A quién llega la notificación
MAIL_TO_ADDRESS=recepcion@tudominio.com
MAIL_TO_NAME="Recepción - Dr. Aldo Avellaneda"

# Email de respuesta (REPLY-TO)
# A donde llegarán las respuestas si el paciente responde al email
MAIL_REPLY_TO_ADDRESS=contacto@tudominio.com

# ==================================
# CONFIGURACIÓN DE CORS Y SEGURIDAD
# ==================================

# Orígenes permitidos para desarrollo (separados por coma)
ALLOWED_ORIGINS_DEV=http://localhost:3000,http://localhost:4321,http://127.0.0.1:3000

# Orígenes permitidos para producción (separados por coma)
ALLOWED_ORIGINS_PROD=https://tudominio.com,https://www.tudominio.com

# Modo desarrollo (true en local, false en producción)
DEV_MODE=true

# ==================================
# RATE LIMITING
# ==================================

# Máximo de intentos por IP por hora
MAX_ATTEMPTS_PER_HOUR=5

# ==================================
# ASUNTOS DE EMAILS
# ==================================

# Asunto de notificación en español
EMAIL_SUBJECT_NOTIFICATION_ES="Nueva Solicitud de Cita - Dr. Aldo Avellaneda"

# Asunto de notificación en inglés
EMAIL_SUBJECT_NOTIFICATION_EN="New Appointment Request - Dr. Aldo Avellaneda"

# Asunto de confirmación en español
EMAIL_SUBJECT_CONFIRMATION_ES="Confirmación de Solicitud Recibida"

# Asunto de confirmación en inglés
EMAIL_SUBJECT_CONFIRMATION_EN="Appointment Request Received"
