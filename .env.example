# Google Tag Manager
# Obtén tu Container ID en: https://tagmanager.google.com
# Formato: GTM-XXXXXXX
PUBLIC_GTM_ID=

# Google Analytics 4 (GA4)
# Obtén tu Measurement ID en: https://analytics.google.com
# Formato: G-XXXXXXXXXX
# Nota: Si usas GTM, puedes gestionar GA4 desde ahí
PUBLIC_GA_MEASUREMENT_ID=

# Facebook Pixel
# Obtén tu Pixel ID en: Facebook Business Manager > Eventos > Píxeles de datos
# Formato: número de 15 dígitos (ej: 123456789012345)
# Nota: Si usas GTM, puedes gestionar Facebook Pixel desde ahí
PUBLIC_FB_PIXEL_ID=

# Instrucciones:
# 1. Copia este archivo y renómbralo a .env
# 2. Completa los valores con tus IDs reales
# 3. NO subas el archivo .env al repositorio (ya está en .gitignore)
