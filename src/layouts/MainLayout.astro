---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  lang: "es" | "en";
  ogImage?: string;
}

const { title, description, lang, ogImage = "/hero-img.png" } = Astro.props;

const schema = {
  "@context": "https://schema.org",
  "@type": "Physician",
  name: "Dr. José Aldo Avellaneda",
  specialty: lang === "es" ? "Cirugía de Columna Vertebral" : "Spine Surgery",
  address: {
    "@type": "PostalAddress",
    streetAddress:
      "Hospital Faro del Mayab, Calle 24 S/N-Consultorio 607, Temozón Norte, Santa Gertrudis Copó",
    addressLocality: "Mérida",
    addressRegion: "Yucatán",
    postalCode: "97300",
    addressCountry: "MX",
  },
  telephone: "+52 999 386 8869",
  url: "https://www.draldoavellaneda.com",
  sameAs: [
    "https://www.facebook.com/DrAldoAvellaneda/?locale=es_LA",
    "https://www.instagram.com/dr.aldo.avellaneda/",
    "https://www.linkedin.com/",
  ],
};

const canonicalURL = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : new URL(Astro.url.pathname, "https://www.draldoavellaneda.com");
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta
      property="og:image"
      content={Astro.site
        ? new URL(ogImage, Astro.site).href
        : `https://www.draldoavellaneda.com${ogImage}`}
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={Astro.url} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content={Astro.site
        ? new URL(ogImage, Astro.site).href
        : `https://www.draldoavellaneda.com${ogImage}`}
    />

    <!-- Schema.org Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />

    <!-- Google Site Verification (Actualizar con tu código) -->
    <!-- <meta name="google-site-verification" content="YOUR_VERIFICATION_CODE" /> -->

    <!-- Favicon -->
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />

    <!-- Preload fonts y recursos críticos -->
    <link rel="preload" href="/styles/bootstrap.min.css" as="style" />

    <!-- Google Analytics 4 (Actualizar con tu GA ID) -->
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-KEM1B2PKQJ"
    ></script>
    <script>
      /* @ts-ignore */
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        /* @ts-ignore */
        dataLayer.push(arguments);
      }
      /* @ts-ignore */
      gtag("js", new Date());
      /* @ts-ignore */
      gtag("config", "G-KEM1B2PKQJ");
    </script>

    <!-- Global Styles -->
  </head>
  <body>
    <slot />

    <!-- Scripts globales jQuery y librerías -->
    <script src="/js/jquery-1.12.4.min.js" is:inline></script>
    <script src="/js/jQueryUi.js" is:inline></script>
    <script src="/js/isotope.pkg.min.js" is:inline></script>
    <script src="/js/lightgallery.min.js" is:inline></script>
    <script src="/js/jquery.slick.min.js" is:inline></script>

    <!-- WOW.js para animaciones -->
    <script src="/js/wow.min.js" is:inline></script>
    <script is:inline>
      // Inicializar sticky header
      window.addEventListener("scroll", () => {
        const header = document.querySelector(".st-sticky-header");
        if (window.scrollY >= 10) {
          header?.classList.add("st-sticky-active");
        } else {
          header?.classList.remove("st-sticky-active");
        }
      });

      // Smooth scroll para enlaces internos
      document.querySelectorAll("a.st-smooth-move").forEach((link) => {
        link.addEventListener("click", (e) => {
          const href = link.getAttribute("href");
          if (href?.startsWith("#")) {
            e.preventDefault();
            const target = document.querySelector(href);
            if (target) {
              target.scrollIntoView({ behavior: "smooth" });
            }
          }
        });
      });
    </script>
  </body>
</html>
