---
import { t } from "../../i18n/translations";
import MapSection from "../sections/MapSection.astro";
import AppointmentSection from "../sections/AppointmentSection.astro";

interface Props {
  lang?: "es" | "en";
}

const { lang = "es" } = Astro.props;
---

<!-- Hero Section -->
<section class="hero-section-contacto st-page-heading st-dynamic-bg">
  <div class="hero-overlay"></div>
  <div class="container" style="position: relative; z-index: 2;">
    <div class="st-page-heading-in text-center">
      <h1 class="hero-title-gradient">{t("pages.contact.hero.title", lang)}</h1>
      <div class="hero-subtitle-gradient">
        {t("pages.contact.hero.subtitle", lang)}
      </div>
    </div>
  </div>
</section>

<!-- Map Section -->
<MapSection {lang} type="short" />

<div class="st-height-b80 st-height-lg-b60"></div>

<!-- Contact Information -->
<section class="container">
  <div class="text-center" style="margin-bottom: 60px;">
    <h2 class="section-title-gradient">
      {t("pages.contact.sectionTitle", lang)}
    </h2>
  </div>

  <div class="row g-4">
    <!-- Ubicaciones Section Title -->
    <div class="col-12">
      <div class="text-center" style="margin-bottom: 40px;">
        <h3 class="location-section-title">
          {t("pages.contact.cards.addresses.title", lang)}
        </h3>
        <p class="location-section-subtitle">
          {t("pages.contact.cards.addresses.subtitle", lang)}
        </p>
      </div>
    </div>

    <!-- Location Cards -->
    {
      (t("footer.contacts.locations", lang) as any[]).map((location: any) => (
        <div class="col-lg-4 col-md-6">
          <div
            class={`contact-card location-card ${location.isPrimary ? "primary-location" : ""}`}
          >
            {location.isPrimary && (
              <div class="location-badge">
                {t("pages.contact.cards.addresses.primaryBadge", lang)}
              </div>
            )}
            <h4 class="location-name">{location.fullName}</h4>
            <p class="location-address">{location.address}</p>
            <div class="location-city">
              <i
                class="fas fa-map-marker-alt"
                style="color: #0cb8b6; margin-right: 5px;"
              />
              {location.city}
            </div>
          </div>
        </div>
      ))
    }

    <!-- Teléfono Card -->
    <div class="col-lg-4 col-md-6">
      <div class="contact-card">
        <h3 class="contact-card-title">
          {t("pages.contact.cards.phone.title", lang)}
        </h3>
        <div class="contact-card-text">
          <a href="tel:+529993868869" class="contact-link"
            >{t("pages.contact.cards.phone.national", lang)}</a
          >
        </div>
      </div>
    </div>

    <!-- Consultas Virtuales Card -->
    <div class="col-lg-4 col-md-6">
      <div class="contact-card">
        <h3 class="contact-card-title">
          {t("pages.contact.cards.virtualConsultations.title", lang)}
        </h3>
        <div class="contact-card-text">
          <Fragment
            set:html={t(
              "pages.contact.cards.virtualConsultations.description",
              lang
            )}
          />
        </div>
      </div>
    </div>
  </div>

  <div class="st-height-b60 st-height-lg-b40"></div>

  <!-- Horario Card (Full Width) -->
  <div class="row">
    <div class="col-12">
      <div class="contact-card hours-card">
        <h3 class="contact-card-title">
          {t("pages.contact.cards.hours.title", lang)}
        </h3>
        <div class="contact-card-text">
          <strong>{t("pages.contact.cards.hours.mondayToFriday", lang)}</strong>
          {
            t("pages.contact.cards.hours.mondayToFridayHours", lang)
          }&nbsp;&nbsp;&nbsp;|&nbsp;&nbsp;&nbsp;<strong
            >{t("pages.contact.cards.hours.saturday", lang)}</strong
          >
          {
            t("pages.contact.cards.hours.saturdayHours", lang)
          }&nbsp;&nbsp;&nbsp;|&nbsp;&nbsp;&nbsp;<strong
            >{t("pages.contact.cards.hours.sunday", lang)}</strong
          >
          {
            t("pages.contact.cards.hours.sundayHours", lang)
          }&nbsp;&nbsp;&nbsp;|&nbsp;&nbsp;&nbsp;<em
            style="font-size: 14px; color: #666;"
            >{t("pages.contact.cards.hours.note", lang)}</em
          >
        </div>
      </div>
    </div>
  </div>

  <div class="st-height-b40 st-height-lg-b30"></div>

  <!-- WhatsApp Card (Full Width) -->
  <div class="row">
    <div class="col-12">
      <div class="contact-card whatsapp-card">
        <div
          style="display: flex; align-items: center; justify-content: center; gap: 15px; margin-bottom: 20px;"
        >
          <i class="fab fa-whatsapp" style="font-size: 3rem; color: #25D366;"
          ></i>
          <h3 class="contact-card-title" style="margin-bottom: 0;">
            {t("pages.contact.cards.whatsapp.title", lang)}
          </h3>
        </div>
        <div class="contact-card-text" style="margin-bottom: 25px;">
          <Fragment
            set:html={t("pages.contact.cards.whatsapp.description", lang)}
          />
        </div>
        <div style="text-align: center;">
          <a
            href={`https://wa.me/${t("contact.whatsapp.yucatan", lang)}?text=${encodeURIComponent(t("contact.whatsapp.defaultMessage", lang))}`}
            target="_blank"
            rel="noopener noreferrer"
            class="whatsapp-btn"
          >
            <i
              class="fab fa-whatsapp"
              style="margin-right: 10px; font-size: 1.3rem;"></i>
            {t("pages.contact.cards.whatsapp.buttonText", lang)}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<div class="st-height-b120 st-height-lg-b80"></div>

<!-- Appointment Section -->
<AppointmentSection {lang} />

<div class="st-height-b120 st-height-lg-b80"></div>

<style>
  /* Hero Section Styles */
  .hero-section-contacto {
    position: relative;
    min-height: 450px;
    background-image: url("/gallery/67c1ca17202f9b1972c06b49_Dr-Avellaneda-_-PM-_-Pulse-8.jpg");
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(
      135deg,
      rgba(12, 184, 182, 0.851) 0%,
      rgba(108, 117, 125, 0.25) 50%,
      rgba(12, 184, 182, 0.851) 100%
    );
    z-index: 1;
  }

  .hero-title-gradient {
    font-size: 4rem;
    font-weight: 800;
    background: linear-gradient(135deg, #ffffff 0%, #e0f2ff 50%, #ffffff 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
    margin-bottom: 20px;
    animation: shimmer 3s ease-in-out infinite;
  }

  .hero-subtitle-gradient {
    font-size: 1.75rem;
    font-weight: 600;
    color: #ffffff;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.4);
    letter-spacing: 1px;
  }

  @keyframes shimmer {
    0%,
    100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }

  /* Section Title with Gradient */
  .section-title-gradient {
    font-size: 2.5rem;
    font-weight: 700;
    background: linear-gradient(135deg, #0cb8b6 0%, #6c757d 50%, #0cb8b6 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    background-size: 200% auto;
    animation: gradientShift 4s ease infinite;
  }

  @keyframes gradientShift {
    0%,
    100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }

  /* Contact Cards */
  .contact-card {
    background: #ffffff;
    border-radius: 12px;
    padding: 40px 30px;
    height: 100%;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    transition: all 0.3s ease;
    border: 1px solid #e0e0e0;
  }

  .contact-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 25px rgba(12, 184, 182, 0.2);
  }

  .contact-card-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: #0cb8b6;
    margin-bottom: 20px;
    text-align: center;
  }

  .contact-card-text {
    font-size: 1rem;
    line-height: 1.8;
    color: #333;
    text-align: center;
  }

  .contact-card-text strong {
    color: #0cb8b6;
    font-weight: 600;
  }

  .contact-link {
    color: #0cb8b6;
    text-decoration: underline;
    font-weight: 600;
    transition: color 0.3s ease;
  }

  .contact-link:hover {
    color: #6c757d;
  }

  .hours-card {
    background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
  }

  .hours-card .contact-card-text {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 10px;
  }

  .whatsapp-card {
    background: linear-gradient(135deg, #e8f8f0 0%, #ffffff 100%);
    border: 2px solid #25d366;
  }

  .whatsapp-card:hover {
    border-color: #1da851;
    box-shadow: 0 8px 30px rgba(37, 211, 102, 0.3);
  }

  .whatsapp-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 15px 35px;
    background: linear-gradient(135deg, #25d366 0%, #1da851 100%);
    color: white;
    font-weight: 700;
    font-size: 1.1rem;
    border-radius: 50px;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(37, 211, 102, 0.3);
  }

  .whatsapp-btn:hover {
    background: linear-gradient(135deg, #1da851 0%, #128c3d 100%);
    transform: translateY(-3px);
    box-shadow: 0 6px 20px rgba(37, 211, 102, 0.5);
    color: white;
  }

  /* Location Section Styles */
  .location-section-title {
    font-size: 2rem;
    font-weight: 700;
    background: linear-gradient(135deg, #0cb8b6 0%, #6c757d 50%, #0cb8b6 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    background-size: 200% auto;
    animation: gradientShift 4s ease infinite;
    margin-bottom: 10px;
  }

  .location-section-subtitle {
    font-size: 1.1rem;
    color: #666;
    font-weight: 400;
  }

  /* Location Cards */
  .location-card {
    position: relative;
    background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
    border-left: 4px solid #0cb8b6;
    min-height: 240px;
    display: flex;
    flex-direction: column;
  }

  .location-card.primary-location {
    border-left-width: 6px;
    background: linear-gradient(135deg, #e8f8f0 0%, #ffffff 100%);
    box-shadow: 0 4px 20px rgba(12, 184, 182, 0.15);
  }

  .location-badge {
    position: absolute;
    top: -12px;
    right: 20px;
    background: linear-gradient(135deg, #0cb8b6 0%, #0a9d9b 100%);
    color: white;
    padding: 6px 18px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    box-shadow: 0 2px 8px rgba(12, 184, 182, 0.3);
  }

  .location-name {
    font-size: 1.25rem;
    font-weight: 700;
    color: #0cb8b6;
    margin-bottom: 18px;
    line-height: 1.3;
    min-height: 50px;
  }

  .location-address {
    color: #333;
    font-size: 0.95rem;
    line-height: 1.7;
    margin-bottom: 15px;
    flex-grow: 1;
  }

  .location-city {
    color: #0cb8b6;
    font-size: 0.9rem;
    font-weight: 600;
    margin-top: auto;
    padding-top: 10px;
    border-top: 1px solid #e0e0e0;
  }

  /* Responsive adjustments */
  @media (max-width: 991px) {
    .hero-section-contacto {
      min-height: 350px;
    }

    .hero-title-gradient {
      font-size: 2.5rem;
    }

    .hero-subtitle-gradient {
      font-size: 1.3rem;
    }

    .section-title-gradient {
      font-size: 2rem;
    }

    .contact-card {
      padding: 30px 20px;
      margin-bottom: 20px;
    }

    .contact-card-title {
      font-size: 1.3rem;
    }

    .hours-card .contact-card-text {
      flex-direction: column;
      gap: 15px;
    }

    .whatsapp-btn {
      font-size: 1rem;
      padding: 12px 25px;
    }

    .location-section-title {
      font-size: 1.75rem;
    }

    .location-section-subtitle {
      font-size: 1rem;
    }

    .location-card {
      margin-bottom: 20px;
      min-height: auto;
    }

    .location-name {
      font-size: 1.15rem;
      min-height: auto;
    }
  }

  @media (max-width: 576px) {
    .hero-title-gradient {
      font-size: 2rem;
    }

    .hero-subtitle-gradient {
      font-size: 1.1rem;
    }

    .section-title-gradient {
      font-size: 1.75rem;
    }

    .contact-card-title {
      font-size: 1.2rem;
    }

    .contact-card-text {
      font-size: 0.95rem;
    }

    .whatsapp-btn {
      font-size: 0.95rem;
      padding: 12px 20px;
      width: 100%;
    }

    .location-section-title {
      font-size: 1.5rem;
    }

    .location-badge {
      font-size: 10px;
      padding: 5px 12px;
      right: 15px;
    }

    .location-name {
      font-size: 1.1rem;
    }

    .location-address {
      font-size: 0.9rem;
    }
  }
</style>
