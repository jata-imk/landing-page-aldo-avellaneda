---
interface Props {
  lang: string;
}

const { lang } = Astro.props;
import { t } from "../../i18n/translations";
---

<!-- Hero Section -->
<section class="hero-section-aldo st-page-heading st-dynamic-bg">
  <div class="hero-overlay"></div>
  <div class="container" style="position: relative; z-index: 2;">
    <div class="st-page-heading-in text-center">
      <h1 class="hero-title-gradient">
        {t("pages.aboutDrAldo.hero.title", lang)}
      </h1>
      <div class="hero-subtitle-gradient">
        {t("pages.aboutDrAldo.hero.subtitle", lang)}
      </div>
    </div>
  </div>
</section>
<div class="st-height-b120 st-height-lg-b80"></div>

<!-- Main Content -->
<section class="container">
  <div class="row">
    <!-- Doctor Image -->
    <div class="col-lg-5">
      <div class="st-member-img">
        <img
          src="/gallery/67c1ca17202f9b1972c06b49_Dr-Avellaneda-_-PM-_-Pulse-8.jpg"
          alt="Dr. Aldo Avellaneda"
          style="width: 100%; height: auto; border-radius: 8px; box-shadow: 0 6px 20px rgba(0,0,0,0.1);"
        />
      </div>
      <div class="st-height-b0 st-height-lg-b30"></div>
    </div>

    <!-- Doctor Information -->
    <div class="col-lg-7">
      <div class="st-vertical-middle">
        <div class="st-vertical-middle-in">
          <div class="st-text-block st-style1 text-center">
            <h2 class="st-text-block-title">
              {t("pages.aboutDrAldo.mainContent.title", lang)}
            </h2>
            <div class="st-height-b20 st-height-lg-b20"></div>

            <div class="st-text-block-text">
              <p>
                {t("pages.aboutDrAldo.mainContent.paragraph1", lang)}
              </p>
              <p>
                {t("pages.aboutDrAldo.mainContent.paragraph2", lang)}
              </p>

              <div class="st-height-b25 st-height-lg-b25"></div>

              <!-- CTA Button -->
              <a
                href="/#appointment"
                class="st-btn st-style1 st-color1 st-size-medium"
              >
                {t("pages.aboutDrAldo.mainContent.button", lang)}
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<div class="st-height-b120 st-height-lg-b80"></div>

<!-- Especialidades Section -->
<section class="especialidades-section">
  <div class="container">
    <div class="text-center" style="margin-bottom: 60px;">
      <h2 class="section-title-gradient">
        {t("pages.aboutDrAldo.specialties.title", lang)}
      </h2>
      <p
        style="font-size: 1.1rem; color: #666; max-width: 700px; margin: 20px auto 0;"
      >
        {t("pages.aboutDrAldo.specialties.subtitle", lang)}
      </p>
    </div>

    <div class="row g-4">
      <div class="col-lg-4 col-md-6">
        <div class="specialty-card">
          <div class="specialty-icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="48"
              height="48"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"
              ></path>
            </svg>
          </div>
          <h3 class="specialty-title">
            {t("pages.aboutDrAldo.specialties.items.0.title", lang)}
          </h3>
          <p class="specialty-description">
            {t("pages.aboutDrAldo.specialties.items.0.description", lang)}
          </p>
        </div>
      </div>

      <div class="col-lg-4 col-md-6">
        <div class="specialty-card">
          <div class="specialty-icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="48"
              height="48"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M12 16v-4M12 8h.01"></path>
            </svg>
          </div>
          <h3 class="specialty-title">
            {t("pages.aboutDrAldo.specialties.items.1.title", lang)}
          </h3>
          <p class="specialty-description">
            {t("pages.aboutDrAldo.specialties.items.1.description", lang)}
          </p>
        </div>
      </div>

      <div class="col-lg-4 col-md-6">
        <div class="specialty-card">
          <div class="specialty-icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="48"
              height="48"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M3 3v18h18"></path>
              <path d="M18 17V9"></path>
              <path d="M13 17V5"></path>
              <path d="M8 17v-3"></path>
            </svg>
          </div>
          <h3 class="specialty-title">
            {t("pages.aboutDrAldo.specialties.items.2.title", lang)}
          </h3>
          <p class="specialty-description">
            {t("pages.aboutDrAldo.specialties.items.2.description", lang)}
          </p>
        </div>
      </div>

      <div class="col-lg-4 col-md-6">
        <div class="specialty-card">
          <div class="specialty-icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="48"
              height="48"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"
              ></path>
              <polyline points="14 2 14 8 20 8"></polyline>
            </svg>
          </div>
          <h3 class="specialty-title">
            {t("pages.aboutDrAldo.specialties.items.3.title", lang)}
          </h3>
          <p class="specialty-description">
            {t("pages.aboutDrAldo.specialties.items.3.description", lang)}
          </p>
        </div>
      </div>

      <div class="col-lg-4 col-md-6">
        <div class="specialty-card">
          <div class="specialty-icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="48"
              height="48"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="9" y1="9" x2="15" y2="15"></line>
              <line x1="15" y1="9" x2="9" y2="15"></line>
            </svg>
          </div>
          <h3 class="specialty-title">
            {t("pages.aboutDrAldo.specialties.items.4.title", lang)}
          </h3>
          <p class="specialty-description">
            {t("pages.aboutDrAldo.specialties.items.4.description", lang)}
          </p>
        </div>
      </div>

      <div class="col-lg-4 col-md-6">
        <div class="specialty-card">
          <div class="specialty-icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="48"
              height="48"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"
              ></path>
              <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
              <line x1="12" y1="22.08" x2="12" y2="12"></line>
            </svg>
          </div>
          <h3 class="specialty-title">
            {t("pages.aboutDrAldo.specialties.items.5.title", lang)}
          </h3>
          <p class="specialty-description">
            {t("pages.aboutDrAldo.specialties.items.5.description", lang)}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<div class="st-height-b120 st-height-lg-b80"></div>

<!-- Timeline Section -->
<section
  class="timeline-section"
  style="background-color: #f8f9fa; padding: 80px 0;"
>
  <div class="container">
    <div class="text-center">
      <img
        src="/my-icons/icono-graduacion.svg"
        alt="Icono de graduación"
        style="width: 75px; height: 75px; margin-bottom: 20px;"
      />
    </div>
    <!-- Section Title -->
    <div class="text-center" style="margin-bottom: 60px;">
      <h2
        class="st-text-block-title"
        style="font-size: 2.5rem; margin-bottom: 20px;"
      >
        {t("pages.aboutDrAldo.timeline.mainTitle", lang)}<br />
        {t("pages.aboutDrAldo.timeline.mainSubtitle", lang)}
      </h2>
    </div>

    <!-- Education Section -->
    <div class="timeline-item" style="margin-bottom: 60px;">
      <div class="row">
        <div class="col-lg-5">
          <h3 class="timeline-title">
            {t("pages.aboutDrAldo.timeline.education.title", lang)}
          </h3>
          <p
            class="timeline-description"
            set:html={t(
              "pages.aboutDrAldo.timeline.education.description",
              lang
            )}
          />
        </div>
        <div class="col-lg-7">
          <ul class="timeline-list">
            {
              t("pages.aboutDrAldo.timeline.education.items", lang).map(
                (item: string) => <li set:html={item} />
              )
            }
          </ul>
        </div>
      </div>
    </div>

    <!-- Professional Experience Section -->
    <div class="timeline-item" style="margin-bottom: 60px;">
      <div class="row">
        <div class="col-lg-5">
          <h3 class="timeline-title">
            {t("pages.aboutDrAldo.timeline.experience.title", lang)}
          </h3>
          <p
            class="timeline-description"
            set:html={t(
              "pages.aboutDrAldo.timeline.experience.description",
              lang
            )}
          />
        </div>
        <div class="col-lg-7">
          <ul class="timeline-list">
            {
              t("pages.aboutDrAldo.timeline.experience.items", lang).map(
                (item: string) => <li set:html={item} />
              )
            }
          </ul>
        </div>
      </div>
    </div>

    <!-- Certifications Section -->
    <div class="timeline-item" style="margin-bottom: 60px;">
      <div class="row">
        <div class="col-lg-5">
          <h3 class="timeline-title">
            {t("pages.aboutDrAldo.timeline.certifications.title", lang)}
          </h3>
          <p
            class="timeline-description"
            set:html={t(
              "pages.aboutDrAldo.timeline.certifications.description",
              lang
            )}
          />
        </div>
        <div class="col-lg-7">
          <ul class="timeline-list">
            {
              t("pages.aboutDrAldo.timeline.certifications.items", lang).map(
                (item: string) => <li set:html={item} />
              )
            }
          </ul>
        </div>
      </div>
    </div>

    <!-- Continuous Learning Section -->
    <div class="timeline-item">
      <div class="row">
        <div class="col-lg-5">
          <h3 class="timeline-title">
            {t("pages.aboutDrAldo.timeline.continuousLearning.title", lang)}
          </h3>
          <p
            class="timeline-description"
            set:html={t(
              "pages.aboutDrAldo.timeline.continuousLearning.description",
              lang
            )}
          />
        </div>
        <div class="col-lg-7">
          <ul class="timeline-list">
            {
              t(
                "pages.aboutDrAldo.timeline.continuousLearning.items",
                lang
              ).map((item: string) => <li set:html={item} />)
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<div class="st-height-b120 st-height-lg-b80"></div>

<!-- Contact Information Section -->
<section class="contact-info-section">
  <div class="container">
    <div class="row align-items-center">
      <!-- Text Content -->
      <div class="col-lg-6">
        <h2 class="contact-info-title">
          {t("pages.aboutDrAldo.contactInfo.title", lang)}
        </h2>
        <div class="contact-info-text">
          <p set:html={t("pages.aboutDrAldo.contactInfo.paragraph1", lang)} />
          <p set:html={t("pages.aboutDrAldo.contactInfo.paragraph2", lang)} />
          <div class="st-height-b30 st-height-lg-b30"></div>
          <a href="/contacto" class="st-btn st-style1 st-color1 st-size-medium">
            {t("pages.aboutDrAldo.contactInfo.button", lang)}
          </a>
        </div>
      </div>

      <!-- Image -->
      <div class="col-lg-6">
        <div class="contact-info-image-wrapper">
          <img
            src="/gallery/67c407f602b65c00eb5e2111_Dr-Avellaneda-_-PM-_-Pulse-11.jpg"
            alt={t("pages.aboutDrAldo.contactInfo.imageAlt", lang)}
            class="contact-info-image"
          />
        </div>
        <div class="st-height-b0 st-height-lg-b30"></div>
      </div>
    </div>
  </div>
</section>

<div class="st-height-b120 st-height-lg-b80"></div>

<style>
  /* Hero Section Styles */
  .hero-section-aldo {
    position: relative;
    min-height: 450px;
    background-image: url("/gallery/67c1ca17202f9b1972c06b49_Dr-Avellaneda-_-PM-_-Pulse-8.jpg");
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(
      135deg,
      rgba(12, 184, 182, 0.851) 0%,
      rgba(108, 117, 125, 0.25) 50%,
      rgba(12, 184, 182, 0.851) 100%
    );
    z-index: 1;
  }

  .hero-title-gradient {
    font-size: 4rem;
    font-weight: 800;
    background: linear-gradient(135deg, #ffffff 0%, #e0f2ff 50%, #ffffff 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
    margin-bottom: 20px;
    animation: shimmer 3s ease-in-out infinite;
  }

  .hero-subtitle-gradient {
    font-size: 1.75rem;
    font-weight: 600;
    color: #ffffff;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.4);
    letter-spacing: 1px;
  }

  @keyframes shimmer {
    0%,
    100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }

  /* Especialidades Section */
  .especialidades-section {
    padding: 80px 0;
  }

  .section-title-gradient {
    font-size: 2.5rem;
    font-weight: 700;
    background: linear-gradient(135deg, #0cb8b6 0%, #6c757d 50%, #0cb8b6 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    background-size: 200% auto;
    animation: gradientShift 4s ease infinite;
  }

  @keyframes gradientShift {
    0%,
    100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }

  .specialty-card {
    background: #ffffff;
    border-radius: 20px;
    padding: 40px 30px;
    height: 100%;
    position: relative;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    border: 2px solid transparent;
    background-clip: padding-box;
  }

  .specialty-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    border-radius: 20px;
    padding: 2px;
    background: linear-gradient(135deg, #0cb8b6, #6c757d, #0cb8b6);
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .specialty-card::after {
    content: "";
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(
      circle,
      rgba(13, 110, 253, 0.1) 0%,
      transparent 70%
    );
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }

  .specialty-card:hover {
    transform: translateY(-10px) scale(1.02);
    box-shadow: 0 20px 40px rgba(13, 110, 253, 0.3);
  }

  .specialty-card::before {
    opacity: 1;
    animation: rotateBorder 3s linear infinite;
  }

  .specialty-card:hover::after {
    opacity: 1;
  }

  @keyframes rotateBorder {
    0% {
      filter: hue-rotate(0deg);
    }
    100% {
      filter: hue-rotate(360deg);
    }
  }

  .specialty-icon {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: linear-gradient(135deg, #0cb8b6 0%, #6c757d 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 25px;
    color: white;
    transition: all 0.4s ease;
    position: relative;
    box-shadow: 0 8px 16px rgba(13, 110, 253, 0.3);
  }

  .specialty-card:hover .specialty-icon {
    transform: rotate(360deg) scale(1.1);
    box-shadow: 0 12px 24px rgba(13, 110, 253, 0.5);
  }

  .specialty-title {
    font-size: 1.4rem;
    font-weight: 700;
    margin-bottom: 15px;
    color: #1a1a1a;
    transition: color 0.3s ease;
  }

  .specialty-card:hover .specialty-title {
    background: linear-gradient(135deg, #0cb8b6 0%, #6c757d 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .specialty-description {
    font-size: 1rem;
    line-height: 1.6;
    color: #666;
    margin-bottom: 0;
  }

  /* Timeline Section */
  .timeline-section {
    position: relative;
  }

  .timeline-title {
    font-size: 1.75rem;
    font-weight: 700;
    margin-bottom: 20px;
    color: #1a1a1a;
    line-height: 1.3;
  }

  .timeline-description {
    font-size: 1rem;
    line-height: 1.6;
    color: #666;
    margin-bottom: 0;
  }

  .timeline-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .timeline-list li {
    position: relative;
    padding-left: 30px;
    margin-bottom: 20px;
    font-size: 1rem;
    line-height: 1.6;
    color: #333;
  }

  .timeline-list li:before {
    content: "●";
    position: absolute;
    left: 0;
    top: 0;
    color: #0cb8b6;
    font-size: 1.2rem;
  }

  .timeline-list li strong {
    color: #1a1a1a;
    font-weight: 600;
  }

  .timeline-item {
    opacity: 1;
    transform: translateY(0);
    transition: all 0.6s ease;
    border-bottom: 1px solid #6a6a6a;
  }

  /* Responsive adjustments */
  @media (max-width: 991px) {
    .hero-section-aldo {
      min-height: 350px;
    }

    .hero-title-gradient {
      font-size: 2.5rem;
    }

    .hero-subtitle-gradient {
      font-size: 1.3rem;
    }

    .section-title-gradient {
      font-size: 2rem;
    }

    .especialidades-section {
      padding: 60px 0;
    }

    .specialty-card {
      padding: 30px 20px;
      margin-bottom: 20px;
    }

    .timeline-title {
      font-size: 1.5rem;
      margin-bottom: 15px;
    }

    .timeline-description {
      margin-bottom: 20px;
    }

    .timeline-section {
      padding: 60px 0 !important;
    }

    .timeline-item {
      margin-bottom: 40px !important;
    }
  }

  @media (max-width: 576px) {
    .hero-title-gradient {
      font-size: 2rem;
    }

    .hero-subtitle-gradient {
      font-size: 1.1rem;
    }

    .specialty-icon {
      width: 60px;
      height: 60px;
    }

    .specialty-icon svg {
      width: 32px;
      height: 32px;
    }
  }

  /* Contact Information Section */
  .contact-info-section {
    padding: 80px 0;
    position: relative;
  }

  .contact-info-title {
    font-size: 2.5rem;
    font-weight: 700;
    background: linear-gradient(135deg, #0cb8b6 0%, #6c757d 50%, #0cb8b6 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    background-size: 200% auto;
    animation: gradientShift 4s ease infinite;
    margin-bottom: 30px;
    line-height: 1.2;
    text-align: center;
  }

  .contact-info-text {
    font-size: 1.1rem;
    line-height: 1.8;
    color: #333;
    text-align: center;
  }

  .contact-info-text p {
    margin-bottom: 20px;
  }

  .contact-info-text strong {
    color: #0cb8b6;
    font-weight: 600;
  }

  .contact-info-image-wrapper {
    position: relative;
  }

  .contact-info-image {
    width: 100%;
    height: auto;
    border-radius: 20px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
    transition: all 0.4s ease;
  }

  .contact-info-image:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 40px rgba(13, 110, 253, 0.3);
  }

  /* Responsive adjustments for contact section */
  @media (max-width: 991px) {
    .contact-info-section {
      padding: 60px 0;
    }

    .contact-info-title {
      font-size: 2rem;
      margin-bottom: 20px;
      text-align: center;
    }

    .contact-info-text {
      font-size: 1rem;
      text-align: center;
    }

    .contact-info-text .st-btn {
      display: block;
      width: fit-content;
      margin: 0 auto;
    }
  }

  @media (max-width: 576px) {
    .contact-info-title {
      font-size: 1.75rem;
    }

    .contact-info-text {
      font-size: 0.95rem;
    }
  }
</style>
