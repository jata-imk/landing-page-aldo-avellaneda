---
import { t } from "../../i18n/translations";

interface Props {
  lang?: "es" | "en";
}

const { lang = "es" } = Astro.props;

// Palabras que rotan en el hero title
const words = t("sections.hero.words", lang) as string[];
---

<div
  id="home"
  class="st-hero-wrap st-gray-bg st-dynamic-bg overflow-hidden st-fixed-bg"
  data-src="/hero-bg.jpg"
>
  {/* Hero Content */}
  <div class="st-hero st-style1">
    <div class="container">
      <div class="st-hero-text">
        <div class="st-height-b40 st-height-lg-b40"></div>
        <h1 class="st-hero-title cd-headline slide">
          {t("sections.hero.titlePart1", lang)}
          <span class="cd-words-wrapper">
            {
              words.map((word, idx) => (
                <b class={idx === 0 ? "is-visible" : ""}>{word}</b>
              ))
            }
          </span>
          {t("sections.hero.titlePart2", lang)}
        </h1>
        <div
          class="st-hero-subtitle"
          set:html={t("sections.hero.subtitle", lang)}
        />
        <div class="st-hero-btn">
          <a
            href={`https://wa.me/${t("contact.whatsapp.yucatan", lang)}?text=${encodeURIComponent(t("contact.whatsapp.defaultMessage", lang))}`}
            class="st-btn st-style1 st-color1"
            target="_blank"
            rel="noopener noreferrer"
          >
            <i class="fab fa-whatsapp"></i>
            {t("sections.hero.button", lang)}
          </a>
        </div>

        {/* Social Media Links */}
        <div
          class="st-hero-social-links"
          style="margin-top: 30px;display: flex;align-items: center;gap: 1rem;"
        >
          Mas redes sociales:
          <ul
            class="st-social-btn st-style1 st-mp0"
            style="justify-content: flex-start; gap: 15px;"
          >
            <li>
              <a
                href="https://www.facebook.com/DrAldoAvellaneda/?locale=es_LA"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Facebook"
              >
                <i class="fab fa-facebook-square" style="font-size: 2rem;"></i>
              </a>
            </li>
            <li>
              <a
                href="https://www.instagram.com/dr.aldo.avellaneda/"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Instagram"
              >
                <i class="fab fa-instagram" style="font-size: 2rem;"></i>
              </a>
            </li>
            <li>
              <a
                href="https://www.linkedin.com/"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="LinkedIn"
              >
                <i class="fab fa-linkedin" style="font-size: 2rem;"></i>
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  {/* Hero Slider */}
  <div class="st-slider st-style1 st-hero-slider1" id="home">
    <div>
      <div class="st-hero-img">
        <img
          src="/gallery/67c01449f8d7b7df6faf2f86_Dr-Aldo-2--1-.png"
          alt="Dr. Aldo Avellaneda - Especialista en Columna Vertebral"
        />
      </div>
    </div>
  </div>

  {/* Hero Shape */}
  <div class="st-hero-shape">
    <img src="/shape/hero-shape.png" alt="hero shape" />
  </div>
</div>

<script>
  // Rotación de palabras en el título
  function rotateWords() {
    const wordsWrapper = document.querySelector(".cd-words-wrapper");
    if (!wordsWrapper) return;

    const words = wordsWrapper.querySelectorAll("b");
    if (words.length === 0) return;

    let currentIndex = 0;

    // Mostrar primera palabra
    words.forEach((word, idx) => {
      word.classList.remove("is-visible");
    });
    words[0].classList.add("is-visible");

    setInterval(() => {
      words[currentIndex].classList.remove("is-visible");
      currentIndex = (currentIndex + 1) % words.length;
      words[currentIndex].classList.add("is-visible");
    }, 3000);
  }

  // Función para esperar a que jQuery y Slick estén disponibles
  function initHeroComponents() {
    let attempts = 0;
    const maxAttempts = 100;

    const checkInterval = setInterval(() => {
      const $ = (window as any).$;
      attempts++;

      if ($ && $.fn.slick) {
        clearInterval(checkInterval);
        rotateWords();
      } else if (attempts >= maxAttempts) {
        clearInterval(checkInterval);
        console.warn(
          "jQuery/Slick no disponible después de intentos, ejecutando fallback"
        );
        rotateWords();
      }
    }, 100);
  }

  // Ejecutar cuando el script se carga
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initHeroComponents);
  } else {
    initHeroComponents();
  }
</script>
