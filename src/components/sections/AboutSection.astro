---
import { t } from "../../i18n/translations";

interface Props {
  lang?: "es" | "en";
}

const { lang = "es" } = Astro.props;
---

<section class="st-about-wrap" id="about">
  <div class="st-shape-bg">
    <img src="/shape/about-bg-shape.svg" alt="shape" />
  </div>
  <div class="st-height-b120 st-height-lg-b50"></div>
  <div class="container">
    <div class="st-section-heading st-style1">
      <h2 class="st-section-heading-title">
        {t("sections.about.title", lang)}
      </h2>
      <div class="st-seperator">
        <div
          class="st-seperator-left wow fadeInLeft"
          data-wow-duration="1s"
          data-wow-delay="0.2s"
        >
        </div>
        <div class="st-seperator-center">
          <img src="/icons/4.png" alt="icon" />
        </div>
        <div
          class="st-seperator-right wow fadeInRight"
          data-wow-duration="1s"
          data-wow-delay="0.2s"
        >
        </div>
      </div>
      <div
        class="st-section-heading-subtitle"
        set:html={t("sections.about.subtitle", lang)}
      />
    </div>
    <div class="st-height-b40 st-height-lg-b40"></div>
  </div>
  <div class="container">
    <div class="row">
      <div class="col-lg-7">
        <div class="st-vertical-middle">
          <div class="st-vertical-middle-in">
            <div class="st-text-block st-style1">
              <h2 class="st-text-block-title">
                {t("sections.about.content.title", lang)}
              </h2>
              <div class="st-height-b20 st-height-lg-b20"></div>

              <!-- Doctor's image and text side by side -->
              <div
                class="st-doctor-info-wrap"
                style="display: flex; align-items: center; gap: 30px; flex-wrap: wrap;"
              >
                <div
                  class="st-doctor-image"
                  style="flex: 0 0 320px; max-width: 320px;"
                >
                  <img
                    src="/gallery/67c1ca17202f9b1972c06b49_Dr-Avellaneda-_-PM-_-Pulse-8.jpg"
                    alt="Dr. Aldo Avellaneda"
                    style="width: 100%; height: auto; border-radius: 8px; box-shadow: 0 6px 15px rgba(0,0,0,0.15);"
                  />
                </div>
                <div
                  class="st-text-block-text"
                  style="flex: 1; min-width: 250px;"
                >
                  <p>{t("sections.about.content.paragraph1", lang)}</p>
                  <p>{t("sections.about.content.paragraph2", lang)}</p>
                </div>
              </div>

              <div class="st-height-b25 st-height-lg-b25"></div>

              <!-- Learn More Button -->
              <a
                href={lang === "es"
                  ? "/acerca-del-dr-aldo-avellaneda"
                  : "/en/about-dr-aldo-avellaneda"}
                class="st-btn st-style1 st-color1 st-size-medium"
                style="width: 100%;"
              >
                {t("sections.about.content.button", lang)}
              </a>
            </div>
          </div>
        </div>
        <div class="st-height-b0 st-height-lg-b30"></div>
      </div>

      <div
        class="col-lg-5 wow fadeInRight"
        data-wow-duration="0.8s"
        data-wow-delay="0.2s"
        style="display: flex; align-items: center;"
      >
        <div class="st-shedule-wrap" style="width: 100%;">
          <div class="st-shedule">
            <h2 class="st-shedule-title">
              {t("sections.about.schedule.title", lang)}
            </h2>
            <ul class="st-shedule-list">
              <li>
                <div class="st-shedule-left">
                  {t("sections.about.schedule.weekdays", lang)}
                </div>
                <div class="st-shedule-right">
                  {t("sections.about.schedule.weekdaysHours", lang)}
                </div>
              </li>
              <li>
                <div class="st-shedule-left">
                  {t("sections.about.schedule.saturday", lang)}
                </div>
                <div class="st-shedule-right">
                  {t("sections.about.schedule.saturdayHours", lang)}
                </div>
              </li>
            </ul>
            <div class="st-height-b25 st-height-lg-b25"></div>
            <div class="st-call st-style1">
              <div class="st-call-text" style="width: 100%;">
                <div class="st-call-title">
                  {t("sections.about.call.title", lang)}
                </div>
                <div class="st-call-number">
                  <div style="display: flex; justify-content: space-between;">
                    <strong
                      >{t("sections.about.call.nationalLabel", lang)}:</strong
                    >
                    <a
                      href={`tel:${t("sections.about.call.national", lang)}`}
                      style="color: inherit; text-decoration: none;"
                    >
                      {t("sections.about.call.national", lang)}
                    </a>
                  </div>
                  <div style="display: flex; justify-content: space-between;">
                    <strong
                      >{
                        t("sections.about.call.internationalLabel", lang)
                      }:</strong
                    >
                    <a
                      href={`tel:${t("sections.about.call.international", lang)}`}
                      style="color: inherit; text-decoration: none;"
                    >
                      {t("sections.about.call.international", lang)}
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Trigger WOW animations
  if ((window as any).WOW) {
    new (window as any).WOW().init();
  }
</script>
