    alt: "Dr. José Aldo Avellaneda durante procedimiento quirúrgico - Cirujano realizando operación",
    categories: ["surgery"],
  },
  {
    id: "2",
    src: "/light-gallery/dr-jose-aldo-avellaneda-en-accion-02.jpg",
    thumb: "/light-gallery/dr-jose-aldo-avellaneda-en-accion-02-small.jpg",
    alt: "Dr. José Aldo Avellaneda en cirugía - Equipo médico en quirófano",
    categories: ["surgery"],
  },
  {
    id: "3",
    src: "/light-gallery/dr-jose-aldo-avellaneda-pacientes-05.JPG",
    thumb: "/light-gallery/dr-jose-aldo-avellaneda-pacientes-05-small.jpg",
    alt: "Dr. José Aldo Avellaneda con paciente satisfecho - Excelencia en cirugía",
    categories: ["success"],
  },
  {
    id: "4",
    src: "/light-gallery/dr-jose-aldo-avellaneda-en-accion-03.jpg",
    thumb: "/light-gallery/dr-jose-aldo-avellaneda-en-accion-03-small.jpg",
    alt: "Dr. José Aldo Avellaneda durante operación - Cirugía de alta precisión",
    categories: ["surgery"],
  },
  {
    id: "5",
    src: "/light-gallery/dr-jose-aldo-avellaneda-pacientes-04.JPG",
    thumb: "/light-gallery/dr-jose-aldo-avellaneda-pacientes-04-small.jpg",
    alt: "Dr. José Aldo Avellaneda con paciente - Atención médica de calidad",
    categories: ["success"],
  },
  {
    id: "6",
    src: "/light-gallery/dr-jose-aldo-avellaneda-pacientes-01.JPG",
    thumb: "/light-gallery/dr-jose-aldo-avellaneda-pacientes-01-small.jpg",
    alt: "Dr. José Aldo Avellaneda con paciente satisfecho - Testimonio de éxito quirúrgico",
    categories: ["success"],
  },
  {
    id: "7",
    src: "/light-gallery/dr-jose-aldo-avellaneda-en-accion-04.jpg",
