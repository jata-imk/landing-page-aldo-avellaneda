---
import { t } from "../../i18n/translations";

interface Props {
  lang?: "es" | "en";
}

const { lang = "es" } = Astro.props;
---

<section class="st-testimonial-wrap">
  <div class="st-height-b120 st-height-lg-b50"></div>
  <div class="container">
    <div class="st-section-heading st-style1">
      <h2 class="st-section-heading-title">
        {t("sections.testimonials.title", lang)}
      </h2>
      <div class="st-seperator">
        <div
          class="st-seperator-left wow fadeInLeft"
          data-wow-duration="1s"
          data-wow-delay="0.2s"
        >
        </div>
        <div class="st-seperator-center">
          <img src="/icons/4.png" alt="icon" />
        </div>
        <div
          class="st-seperator-right wow fadeInRight"
          data-wow-duration="1s"
          data-wow-delay="0.2s"
        >
        </div>
      </div>
      <div class="st-section-heading-subtitle">
        {t("sections.testimonials.subtitle", lang)}
      </div>
    </div>
    <div class="st-height-b40 st-height-lg-b40"></div>
  </div>

  <!-- Trustindex Google Reviews Widget -->
  <div class="container">
    <div class="st-trustindex-widget-container">
      <script
        defer
        async
        src="https://cdn.trustindex.io/loader.js?09f9fd4586261083aa2674e6fd9"
      ></script>
    </div>
  </div>

  <div class="st-height-b120 st-height-lg-b50"></div>
</section>

<style>
  .st-trustindex-widget-container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 15px;
  }

  /* Asegurar que el widget sea responsive */
  @media (max-width: 768px) {
    .st-trustindex-widget-container {
      padding: 0 10px;
    }
  }
</style>

<script>
  // Trigger WOW animations para el título
  if ((window as any).WOW) {
    new (window as any).WOW().init();
  }
</script>
