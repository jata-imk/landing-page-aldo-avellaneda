---
import { t } from "../../i18n/translations";

interface Props {
  lang?: "es" | "en";
}

const { lang = "es" } = Astro.props;

interface Testimonial {
  id: string;
  name: string;
  designation: string;
  image: string;
  text: string;
}

// Obtener testimonios desde las traducciones
const testimonialData = t("sections.testimonials.items", lang) as any;
const testimonials: Testimonial[] = Array.isArray(testimonialData)
  ? testimonialData.map((item: any, idx: number) => ({
      id: String(idx + 1),
      name: item.name,
      designation: item.designation,
      image: item.image,
      text: item.text,
    }))
  : [];
---

<section class="st-testimonial-wrap">
  <div class="st-height-b120 st-height-lg-b50"></div>
  <div class="container">
    <div class="st-section-heading st-style1">
      <h2 class="st-section-heading-title">
        {t("sections.testimonials.title", lang)}
      </h2>
      <div class="st-seperator">
        <div
          class="st-seperator-left wow fadeInLeft"
          data-wow-duration="1s"
          data-wow-delay="0.2s"
        >
        </div>
        <div class="st-seperator-center">
          <img src="/icons/4.png" alt="icon" />
        </div>
        <div
          class="st-seperator-right wow fadeInRight"
          data-wow-duration="1s"
          data-wow-delay="0.2s"
        >
        </div>
      </div>
      <div class="st-section-heading-subtitle">
        {t("sections.testimonials.subtitle", lang)}
      </div>
    </div>
    <div class="st-height-b40 st-height-lg-b40"></div>
  </div>
  <div class="container">
    <div class="st-slider st-style2 st-pricing-wrap" id="testimonials-slider">
      {
        testimonials.map((testimonial, idx) => (
          <div key={testimonial.id} class="slick-slide-in">
            <div
              class={`st-testimonial st-style1 ${
                idx === 0
                  ? "wow fadeInLeft"
                  : idx === 2
                    ? "wow fadeInRight"
                    : ""
              }`}
              data-wow-duration="0.8s"
              data-wow-delay="0.2s"
            >
              <div class="st-testimonial-info">
                <div class="st-testimonial-img">
                  <img src={testimonial.image} alt={testimonial.name} />
                </div>
                <div class="st-testimonial-meta">
                  <h4 class="st-testimonial-name">{testimonial.name}</h4>
                  <div class="st-testimonial-designation">
                    {testimonial.designation}
                  </div>
                </div>
              </div>
              <div class="st-testimonial-text">{testimonial.text}</div>
              <div class="st-quote">
                <i class="fas fa-quote-right" />
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
  <div class="st-height-b120 st-height-lg-b50"></div>
</section>

<script>
  // Inicializar slider con Slick
  function initTestimonialsSlider() {
    const $ = (window as any).$;

    if (!$) {
      console.warn("jQuery is not available");
      return;
    }

    const $slider = $("#testimonials-slider");
    if ($slider.length && $.fn.slick) {
      try {
        $slider.slick({
          autoplay: false,
          infinite: true,
          speed: 600,
          slidesToShow: 3,
          slidesToScroll: 1,
          arrows: true,
          dots: false,
          responsive: [
            {
              breakpoint: 1200,
              settings: {
                slidesToShow: 3,
              },
            },
            {
              breakpoint: 768,
              settings: {
                slidesToShow: 2,
              },
            },
            {
              breakpoint: 576,
              settings: {
                slidesToShow: 1,
              },
            },
          ],
        });
      } catch (e) {
        console.log("Slick not initialized");
      }
    }
  }

  // Esperar a que jQuery y Slick estén disponibles
  document.addEventListener("DOMContentLoaded", () => {
    const checkInterval = setInterval(() => {
      const $ = (window as any).$;
      if ($ && $.fn.slick) {
        initTestimonialsSlider();
        clearInterval(checkInterval);
      }
    }, 100);

    // Timeout para evitar loops infinitos
    setTimeout(() => clearInterval(checkInterval), 5000);
  });

  // Trigger WOW animations
  if ((window as any).WOW) {
    new (window as any).WOW().init();
  }
</script>
