---
interface Props {
  lang?: "es" | "en";
  type?: "default" | "tall" | "short"; // default=500px, tall=600px, short=400px
}

const { lang = "es", type = "default" } = Astro.props;

// Clase CSS según el tipo de altura
const typeClass =
  type === "tall" ? "st-type1" : type === "short" ? "st-type2" : "";
---

<div class={`mt-4 st-google-map ${typeClass}`}>
  <iframe
    src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3724.4120995912936!2d-89.5850012!3d21.0161907!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8f5676f669555555%3A0xd6a48100ff0e2fe7!2sOrtopedista%2C%20Traumat%C3%B3log%C3%ADa%20M%C3%A9rida%2C%20Canc%C3%BAn%20%7C%20Dr.%20Aldo%20Avellaneda%20%7C%20Especialista%20en%20Columna%20%7C%20Cirug%C3%ADa%20M%C3%ADnima%20Invasi%C3%B3n!5e0!3m2!1ses-419!2smx!4v1762925934314!5m2!1ses-419!2smx"
    allowfullscreen
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    title={lang === "es"
      ? "Ubicación del Dr. Aldo Avellaneda - Hospital Faro del Mayab, Mérida"
      : "Location of Dr. Aldo Avellaneda - Hospital Faro del Mayab, Mérida"}
  ></iframe>
</div>

<style>
  .st-google-map iframe {
    width: 100%;
    height: 500px;
    display: block;
    border: none;
  }

  .st-google-map.st-type1 iframe {
    height: 600px;
  }

  .st-google-map.st-type2 iframe {
    height: 400px;
  }

  @media (max-width: 768px) {
    .st-google-map iframe {
      height: 350px;
    }

    .st-google-map.st-type1 iframe {
      height: 450px;
    }

    .st-google-map.st-type2 iframe {
      height: 250px;
    }
  }
</style>
