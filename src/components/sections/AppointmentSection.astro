---
import { t } from "../../i18n/translations";

interface Props {
  lang?: "es" | "en";
}

const { lang = "es" } = Astro.props;
---

<section id="appointment" class="st-shape-wrap st-gray-bg">
  <div class="st-shape4">
    <img src="/shape/section_shape.png" alt="shape1" />
  </div>
  <div class="st-shape6">
    <img src="/shape/contact-shape3.svg" alt="shape3" />
  </div>
  <div class="st-height-b120 st-height-lg-b50"></div>
  <div class="container">
    <div class="st-section-heading st-style1">
      <h2 class="st-section-heading-title">
        {t("sections.appointment.title", lang)}
      </h2>
      <div class="st-seperator">
        <div
          class="st-seperator-left wow fadeInLeft"
          data-wow-duration="1s"
          data-wow-delay="0.2s"
        >
        </div>
        <div class="st-seperator-center">
          <img src="/my-icons/4.png" alt="icon" />
        </div>
        <div
          class="st-seperator-right wow fadeInRight"
          data-wow-duration="1s"
          data-wow-delay="0.2s"
        >
        </div>
      </div>
    </div>
  </div>
  <div class="container">
    <div class="row">
      <div class="col-lg-10 offset-lg-1">
        <form class="st-appointment-form" id="appointment-form">
          <div class="row">
            {/* Full Name */}
            <div class="col-lg-6">
              <div class="st-form-field st-style1">
                <label>{t("forms.appointment.fullName", lang)}</label>
                <input
                  type="text"
                  name="fullName"
                  placeholder={t("forms.appointment.fullNamePlaceholder", lang)}
                  required
                  minlength="3"
                />
              </div>
            </div>

            {/* Email */}
            <div class="col-lg-6">
              <div class="st-form-field st-style1">
                <label>{t("forms.appointment.email", lang)}</label>
                <input
                  type="email"
                  name="email"
                  placeholder={t("forms.appointment.emailPlaceholder", lang)}
                  required
                />
              </div>
            </div>

            {/* Phone Number */}
            <div class="col-lg-6">
              <div class="st-form-field st-style1">
                <label>{t("forms.appointment.phone", lang)}</label>
                <input
                  type="tel"
                  name="phone"
                  placeholder={t("forms.appointment.phonePlaceholder", lang)}
                  required
                  pattern="[+\d\s\-()]+"
                />
              </div>
            </div>

            {/* Preferred Language Select */}
            <div class="col-lg-6">
              <div class="st-form-field st-style1">
                <label>{t("forms.appointment.preferredLanguage", lang)}</label>
                <div class="st-custom-select-wrap">
                  <select name="preferredLanguage" required>
                    <option value=""
                      >{
                        t(
                          "forms.appointment.preferredLanguagePlaceholder",
                          lang
                        )
                      }</option
                    >
                    <option value="spanish">
                      {t("forms.appointment.languageOptions.spanish", lang)}
                    </option>
                    <option value="english">
                      {t("forms.appointment.languageOptions.english", lang)}
                    </option>
                  </select>
                </div>
              </div>
            </div>

            {/* Message */}
            <div class="col-lg-12">
              <div class="st-form-field st-style1">
                <label>{t("forms.appointment.message", lang)}</label>
                <textarea
                  cols={30}
                  rows={10}
                  name="message"
                  placeholder={t("forms.appointment.messagePlaceholder", lang)}
                  minlength="10"></textarea>
              </div>
            </div>

            {/* Submit Button */}
            <div class="col-lg-12 text-center">
              <button
                class="st-btn st-style1 st-color1 st-size-medium"
                type="submit"
              >
                {t("forms.appointment.submit", lang)}
              </button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>

  <div class="st-height-b120 st-height-lg-b80"></div>
</section>

<script>
  const form = document.getElementById("appointment-form") as HTMLFormElement;

  // Endpoint API: localhost:8000 en dev, /api en producción
  const API_ENDPOINT = import.meta.env.DEV
    ? "http://localhost:8000/api/appointment.php"
    : "/api/appointment.php";

  if (form) {
    // Estado del formulario
    let isSubmitting = false;

    // Elementos UI
    const submitButton = form.querySelector(
      'button[type="submit"]'
    ) as HTMLButtonElement;
    const originalButtonText = submitButton.textContent || "";

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      // Prevenir envíos múltiples
      if (isSubmitting) return;
      isSubmitting = true;

      // UI feedback: deshabilitar botón y cambiar texto
      submitButton.disabled = true;
      const lang = document.documentElement.lang || "es";
      submitButton.textContent =
        lang === "es" ? "Enviando..." : "Sending...";

      try {
        // Obtener datos del formulario
        const formData = new FormData(form);
        const data = Object.fromEntries(formData);

        console.log("Enviando solicitud a:", API_ENDPOINT);

        // Enviar a la API
        const response = await fetch(API_ENDPOINT, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify(data),
        });

        const result = await response.json();

        if (result.success) {
          // Éxito: mostrar mensaje y resetear formulario
          alert(result.message);
          form.reset();

          // Opcional: scroll a la parte superior
          window.scrollTo({ top: 0, behavior: "smooth" });
        } else {
          // Error del servidor con mensaje específico
          throw new Error(result.message || "Error desconocido");
        }
      } catch (error) {
        // Error de red o del servidor
        console.error("Error al enviar solicitud:", error);

        const lang = document.documentElement.lang || "es";
        const errorMessage =
          lang === "es"
            ? "Error al enviar la solicitud. Por favor intenta nuevamente o contáctanos directamente por WhatsApp."
            : "Error sending request. Please try again or contact us directly via WhatsApp.";

        alert(errorMessage);
      } finally {
        // Restaurar estado del botón
        isSubmitting = false;
        submitButton.disabled = false;
        submitButton.textContent = originalButtonText;
      }
    });
  }

  // Trigger WOW animations
  if ((window as any).WOW) {
    new (window as any).WOW().init();
  }
</script>
