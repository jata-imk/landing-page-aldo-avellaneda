---
import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import AboutDrAldoContent from "../components/pages/AboutDrAldoContent.astro";
import { t } from "../i18n/translations";

const lang = "es";
const title = t("pages.aboutDrAldo.title", lang);
const description = t("pages.aboutDrAldo.description", lang);
---

<MainLayout
  {title}
  {description}
  {lang}
  ogImage="/gallery/67c1ca17202f9b1972c06b49_Dr-Avellaneda-_-PM-_-Pulse-8.jpg"
>
  <div class="st-content">
    <Header {lang} />

    <main>
      <AboutDrAldoContent {lang} />
    </main>

    <Footer {lang} />
  </div>
</MainLayout>
