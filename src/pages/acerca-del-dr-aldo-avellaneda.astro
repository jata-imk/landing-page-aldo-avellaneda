---
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

const title = 'Acerca del Dr. Aldo Avellaneda - Cirujano de Columna Vertebral';
const description = 'Conozca al Dr. Aldo Avellaneda, cirujano de columna vertebral altamente calificado especializado en procedimientos complejos y técnicas mínimamente invasivas.';
const lang = 'es';
---

<MainLayout {title} {description} {lang} ogImage="/gallery/67c1ca17202f9b1972c06b49_Dr-Avellaneda-_-PM-_-Pulse-8.jpg">
  <div class="st-content">
    <Header {lang} />

    <main>
      <!-- Hero Section -->
      <section class="hero-section-aldo st-page-heading st-dynamic-bg">
        <div class="hero-overlay"></div>
        <div class="container" style="position: relative; z-index: 2;">
          <div class="st-page-heading-in text-center">
            <h1 class="hero-title-gradient">Dr. Aldo Avellaneda</h1>
            <div class="hero-subtitle-gradient">Cirujano de Columna Vertebral</div>
          </div>
        </div>
      </section>
      <div class="st-height-b120 st-height-lg-b80"></div>

      <!-- Main Content -->
      <section class="container">
        <div class="row">
          <!-- Doctor Image -->
          <div class="col-lg-5">
            <div class="st-member-img">
              <img
                src="/gallery/67c1ca17202f9b1972c06b49_Dr-Avellaneda-_-PM-_-Pulse-8.jpg"
                alt="Dr. Aldo Avellaneda"
                style="width: 100%; height: auto; border-radius: 8px; box-shadow: 0 6px 20px rgba(0,0,0,0.1);"
              />
            </div>
            <div class="st-height-b0 st-height-lg-b30"></div>
          </div>

          <!-- Doctor Information -->
          <div class="col-lg-7">
            <div class="st-vertical-middle">
              <div class="st-vertical-middle-in">
                <div class="st-text-block st-style1">
                  <h2 class="st-text-block-title">Especialista en Cirugía de Columna Vertebral</h2>
                  <div class="st-height-b20 st-height-lg-b20"></div>

                  <div class="st-text-block-text">
                    <p>
                      El Dr. Aldo Avellaneda es un cirujano de columna vertebral altamente calificado que se especializa en procedimientos espinales complejos y técnicas mínimamente invasivas.
                    </p>
                    <p>
                      Con una amplia formación y años de experiencia, se ha consolidado como experto de confianza en el tratamiento de afecciones espinales graves, incluidos los casos que antes se consideraban inoperables.
                    </p>

                    <div class="st-height-b25 st-height-lg-b25"></div>


                    <!-- CTA Button -->
                    <a href="/#appointment" class="st-btn st-style1 st-color1 st-size-medium">
                      Agendar una Cita
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <div class="st-height-b120 st-height-lg-b80"></div>

      <!-- Especialidades Section -->
      <section class="especialidades-section">
        <div class="container">
          <div class="text-center" style="margin-bottom: 60px;">
            <h2 class="section-title-gradient">Especialidades</h2>
            <p style="font-size: 1.1rem; color: #666; max-width: 700px; margin: 20px auto 0;">
              Servicios especializados en cirugía de columna vertebral con técnicas de vanguardia
            </p>
          </div>

          <div class="row g-4">
            <div class="col-lg-4 col-md-6">
              <div class="specialty-card">
                <div class="specialty-icon">
                  <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                  </svg>
                </div>
                <h3 class="specialty-title">Cirugía Mínimamente Invasiva</h3>
                <p class="specialty-description">
                  Técnicas avanzadas de columna vertebral que reducen el tiempo de recuperación y minimizan el trauma quirúrgico.
                </p>
              </div>
            </div>

            <div class="col-lg-4 col-md-6">
              <div class="specialty-card">
                <div class="specialty-icon">
                  <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <path d="M12 16v-4M12 8h.01"></path>
                  </svg>
                </div>
                <h3 class="specialty-title">Hernias Discales Complejas</h3>
                <p class="specialty-description">
                  Tratamiento especializado de hernias discales complejas con enfoque personalizado para cada paciente.
                </p>
              </div>
            </div>

            <div class="col-lg-4 col-md-6">
              <div class="specialty-card">
                <div class="specialty-icon">
                  <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 3v18h18"></path>
                    <path d="M18 17V9"></path>
                    <path d="M13 17V5"></path>
                    <path d="M8 17v-3"></path>
                  </svg>
                </div>
                <h3 class="specialty-title">Escoliosis y Deformidades</h3>
                <p class="specialty-description">
                  Corrección quirúrgica de escoliosis y otras deformidades espinales con tecnología de última generación.
                </p>
              </div>
            </div>

            <div class="col-lg-4 col-md-6">
              <div class="specialty-card">
                <div class="specialty-icon">
                  <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                  </svg>
                </div>
                <h3 class="specialty-title">Fusión Espinal</h3>
                <p class="specialty-description">
                  Procedimientos avanzados de fusión espinal para estabilizar y aliviar el dolor en condiciones degenerativas.
                </p>
              </div>
            </div>

            <div class="col-lg-4 col-md-6">
              <div class="specialty-card">
                <div class="specialty-icon">
                  <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="9" y1="9" x2="15" y2="15"></line>
                    <line x1="15" y1="9" x2="9" y2="15"></line>
                  </svg>
                </div>
                <h3 class="specialty-title">Estenosis Espinal</h3>
                <p class="specialty-description">
                  Tratamiento efectivo de la estenosis espinal para aliviar la compresión nerviosa y mejorar la movilidad.
                </p>
              </div>
            </div>

            <div class="col-lg-4 col-md-6">
              <div class="specialty-card">
                <div class="specialty-icon">
                  <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                    <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                    <line x1="12" y1="22.08" x2="12" y2="12"></line>
                  </svg>
                </div>
                <h3 class="specialty-title">Tumores Espinales</h3>
                <p class="specialty-description">
                  Cirugía especializada para tumores espinales con técnicas precisas y cuidado integral del paciente.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <div class="st-height-b120 st-height-lg-b80"></div>

      <!-- Timeline Section -->
      <section class="timeline-section" style="background-color: #f8f9fa; padding: 80px 0;">
        <div class="container">
          <!-- Section Title -->
          <div class="text-center" style="margin-bottom: 60px;">
            <h2 class="st-text-block-title" style="font-size: 2.5rem; margin-bottom: 20px;">
              La experiencia del Dr. Aldo en cirugía de columna vertebral:<br>
              Educación e innovaciones
            </h2>
          </div>

          <!-- Education Section -->
          <div class="timeline-item" style="margin-bottom: 60px;">
            <div class="row">
              <div class="col-lg-5">
                <h3 class="timeline-title">Educación y formación especializada</h3>
                <p class="timeline-description">
                  La educación y la formación especializada del Dr. Aldo lo han posicionado como
                  <strong>líder en cirugía de columna vertebral, particularmente en procedimientos complejos y mínimamente invasivos</strong>.
                  Su formación académica y profesional incluye:
                </p>
              </div>
              <div class="col-lg-7">
                <ul class="timeline-list">
                  <li>
                    <strong>Licenciada en Medicina y Cirugía</strong> de la Universidad Nacional Autónoma de México (UNAM).
                  </li>
                  <li>
                    <strong>Diplomas en Medicina y Ciencias de la Complejidad y Medicina de Emergencias</strong> de la Universidad Nacional Autónoma de México (UNAM).
                  </li>
                  <li>
                    <strong>Especialización en Ortopedia</strong> de la Universidad Nacional Autónoma de México (UNAM).
                  </li>
                  <li>
                    <strong>Entrenamiento avanzado en cirugía de columna vertebral mínimamente invasiva</strong> — Múltiples programas internacionales enfocados en técnicas endoscópicas y asistidas por robot.
                  </li>
                </ul>
              </div>
            </div>
          </div>

          <!-- Professional Experience Section -->
          <div class="timeline-item" style="margin-bottom: 60px;">
            <div class="row">
              <div class="col-lg-5">
                <h3 class="timeline-title">Experiencia profesional y aspectos destacados de la carrera</h3>
                <p class="timeline-description">
                  El Dr. Aldo combina <strong>experiencia quirúrgica con contribuciones académicas</strong>,
                  capacitando regularmente a otros cirujanos y contribuyendo al avance de la cirugía de columna vertebral.
                  Su carrera incluye:
                </p>
              </div>
              <div class="col-lg-7">
                <ul class="timeline-list">
                  <li>
                    <strong>Profesor del Colegio de Ortopedia Yucatán,</strong> dirigiendo sesiones especializadas sobre escoliosis de inicio temprano (2019).
                  </li>
                  <li>
                    <strong>Ponente en el Congreso Nacional de Cirugía de Columna Vertebral en México (2017),</strong> presentación sobre técnicas quirúrgicas avanzadas.
                  </li>
                  <li>
                    <strong>Miembro del cuerpo docente de la Universidad Nacional Autónoma de México (UNAM) (2012),</strong> impartiendo cursos de ortopedia y aparato respiratorio.
                  </li>
                  <li>
                    <strong>Se realizan más de 300 a 400 cirugías de columna al año,</strong> lo que lo convierte en uno de los especialistas en columna vertebral con más experiencia de la región.
                  </li>
                </ul>
              </div>
            </div>
          </div>

          <!-- Certifications Section -->
          <div class="timeline-item" style="margin-bottom: 60px;">
            <div class="row">
              <div class="col-lg-5">
                <h3 class="timeline-title">Certificaciones, reconocimientos y membresías</h3>
                <p class="timeline-description">
                  El Dr. Aldo sostiene <strong>prestigiosas certificaciones y membresías</strong>
                  que subrayan su experiencia y dedicación a la atención de los pacientes:
                </p>
              </div>
              <div class="col-lg-7">
                <ul class="timeline-list">
                  <li>
                    <strong>Certificación de la junta en cirugía ortopédica —</strong> Certificado por el Consejo Mexicano de Traumatología y Ortopedia (2017-2022).
                  </li>
                  <li>
                    <strong>Miembro activo de las organizaciones internacionales de cirugía de columna,</strong> interactuar regularmente con expertos mundiales.
                  </li>
                  <li>
                    <strong>Interactuar regularmente con expertos de todo el mundo</strong> centrado en el avance de la cirugía de columna mínimamente invasiva.
                  </li>
                </ul>
              </div>
            </div>
          </div>

          <!-- Continuous Learning Section -->
          <div class="timeline-item">
            <div class="row">
              <div class="col-lg-5">
                <h3 class="timeline-title">Compromiso con el aprendizaje continuo y la innovación médica</h3>
                <p class="timeline-description">
                  El Dr. Aldo participa activamente en <strong>educación continua, investigación y colaboración internacional</strong>
                  para perfeccionar las técnicas de cirugía de columna. Su desarrollo profesional incluye:
                </p>
              </div>
              <div class="col-lg-7">
                <ul class="timeline-list">
                  <li>
                    <strong>Simposio sobre tumores y deformidades de la columna vertebral —</strong> São Paulo, Brasil (2018).
                  </li>
                  <li>
                    <strong>Curso práctico avanzado sobre cirugía de columna cervical —</strong> Río de Janeiro, Brasil (2018).
                  </li>
                  <li>
                    <strong>Laboratorio de habilidades clínicas para cirugía lumbar mínimamente invasiva —</strong> (2018).
                  </li>
                  <li>
                    <strong>Múltiples cursos y certificaciones de AOSpine Latin America,</strong> centrándose en traumatismos, afecciones degenerativas y técnicas avanzadas mínimamente invasivas (2017).
                  </li>
                  <li>
                    <strong>Investigación sobre el equilibrio sagital en adultos y la artroplastia de disco cervical</strong> con AO North America (2017).
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </section>

      <div class="st-height-b120 st-height-lg-b80"></div>
    </main>

    <Footer {lang} />
  </div>
</MainLayout>

<style>
  /* Hero Section Styles */
  .hero-section-aldo {
    position: relative;
    min-height: 450px;
    background-image: url('/gallery/67c1ca17202f9b1972c06b49_Dr-Avellaneda-_-PM-_-Pulse-8.jpg');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, rgba(13, 110, 253, 0.85) 0%, rgba(108, 117, 125, 0.75) 50%, rgba(13, 110, 253, 0.85) 100%);
    z-index: 1;
  }

  .hero-title-gradient {
    font-size: 4rem;
    font-weight: 800;
    background: linear-gradient(135deg, #ffffff 0%, #e0f2ff 50%, #ffffff 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
    margin-bottom: 20px;
    animation: shimmer 3s ease-in-out infinite;
  }

  .hero-subtitle-gradient {
    font-size: 1.75rem;
    font-weight: 600;
    color: #ffffff;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.4);
    letter-spacing: 1px;
  }

  @keyframes shimmer {
    0%, 100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }

  /* Especialidades Section */
  .especialidades-section {
    padding: 80px 0;
    background: linear-gradient(180deg, #ffffff 0%, #f8f9fa 100%);
  }

  .section-title-gradient {
    font-size: 2.5rem;
    font-weight: 700;
    background: linear-gradient(135deg, #0d6efd 0%, #6c757d 50%, #0d6efd 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    background-size: 200% auto;
    animation: gradientShift 4s ease infinite;
  }

  @keyframes gradientShift {
    0%, 100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }

  .specialty-card {
    background: #ffffff;
    border-radius: 20px;
    padding: 40px 30px;
    height: 100%;
    position: relative;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    border: 2px solid transparent;
    background-clip: padding-box;
  }

  .specialty-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    border-radius: 20px;
    padding: 2px;
    background: linear-gradient(135deg, #0d6efd, #6c757d, #0d6efd);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .specialty-card::after {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle, rgba(13, 110, 253, 0.1) 0%, transparent 70%);
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }

  .specialty-card:hover {
    transform: translateY(-10px) scale(1.02);
    box-shadow: 0 20px 40px rgba(13, 110, 253, 0.3);
  }

  .specialty-card:hover::before {
    opacity: 1;
    animation: rotateBorder 3s linear infinite;
  }

  .specialty-card:hover::after {
    opacity: 1;
  }

  @keyframes rotateBorder {
    0% {
      filter: hue-rotate(0deg);
    }
    100% {
      filter: hue-rotate(360deg);
    }
  }

  .specialty-icon {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: linear-gradient(135deg, #0d6efd 0%, #6c757d 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 25px;
    color: white;
    transition: all 0.4s ease;
    position: relative;
    box-shadow: 0 8px 16px rgba(13, 110, 253, 0.3);
  }

  .specialty-card:hover .specialty-icon {
    transform: rotate(360deg) scale(1.1);
    box-shadow: 0 12px 24px rgba(13, 110, 253, 0.5);
  }

  .specialty-title {
    font-size: 1.4rem;
    font-weight: 700;
    margin-bottom: 15px;
    color: #1a1a1a;
    transition: color 0.3s ease;
  }

  .specialty-card:hover .specialty-title {
    background: linear-gradient(135deg, #0d6efd 0%, #6c757d 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .specialty-description {
    font-size: 1rem;
    line-height: 1.6;
    color: #666;
    margin-bottom: 0;
  }

  /* Timeline Section */
  .timeline-section {
    position: relative;
  }

  .timeline-title {
    font-size: 1.75rem;
    font-weight: 700;
    margin-bottom: 20px;
    color: #1a1a1a;
    line-height: 1.3;
  }

  .timeline-description {
    font-size: 1rem;
    line-height: 1.6;
    color: #666;
    margin-bottom: 0;
  }

  .timeline-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .timeline-list li {
    position: relative;
    padding-left: 30px;
    margin-bottom: 20px;
    font-size: 1rem;
    line-height: 1.6;
    color: #333;
  }

  .timeline-list li:before {
    content: "●";
    position: absolute;
    left: 0;
    top: 0;
    color: #0d6efd;
    font-size: 1.2rem;
  }

  .timeline-list li strong {
    color: #1a1a1a;
    font-weight: 600;
  }

  .timeline-item {
    opacity: 1;
    transform: translateY(0);
    transition: all 0.6s ease;
  }

  /* Responsive adjustments */
  @media (max-width: 991px) {
    .hero-section-aldo {
      min-height: 350px;
    }

    .hero-title-gradient {
      font-size: 2.5rem;
    }

    .hero-subtitle-gradient {
      font-size: 1.3rem;
    }

    .section-title-gradient {
      font-size: 2rem;
    }

    .especialidades-section {
      padding: 60px 0;
    }

    .specialty-card {
      padding: 30px 20px;
      margin-bottom: 20px;
    }

    .timeline-title {
      font-size: 1.5rem;
      margin-bottom: 15px;
    }

    .timeline-description {
      margin-bottom: 20px;
    }

    .timeline-section {
      padding: 60px 0 !important;
    }

    .timeline-item {
      margin-bottom: 40px !important;
    }
  }

  @media (max-width: 576px) {
    .hero-title-gradient {
      font-size: 2rem;
    }

    .hero-subtitle-gradient {
      font-size: 1.1rem;
    }

    .specialty-icon {
      width: 60px;
      height: 60px;
    }

    .specialty-icon svg {
      width: 32px;
      height: 32px;
    }
  }
</style>
