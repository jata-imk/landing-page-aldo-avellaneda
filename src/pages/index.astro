---
import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import HeroSection from "../components/sections/HeroSection.astro";
import AboutSection from "../components/sections/AboutSection.astro";
import AppointmentSection from "../components/sections/AppointmentSection.astro";
import GallerySection from "../components/sections/GallerySection.astro";
import WhyChooseSection from "../components/sections/WhyChooseSection.astro";
import TestimonialsSection from "../components/sections/TestimonialsSection.astro";
import MapSection from "../components/sections/MapSection.astro";

const title = "Dr. José Aldo Avellaneda - Cirugía de Columna Vertebral | Especialista en Mérida, Yucatán";
const description =
  "Cirujano de columna vertebral altamente especializado en procedimientos complejos y técnicas mínimamente invasivas. Atención a pacientes de México, EE.UU. y Canadá en Mérida, Yucatán.";
const lang = "es";
---

<MainLayout {title} {description} {lang} ogImage="/hero-img.png">
  <div class="st-content">
    <Header {lang} isHomepage={true} />

    <main>
      <HeroSection {lang} />
      <AboutSection {lang} />
      <GallerySection {lang} />
      <TestimonialsSection {lang} />
      <WhyChooseSection {lang} />
      <AppointmentSection {lang} />
    </main>

    <MapSection {lang} type="short" />
    <Footer {lang} />
  </div>
</MainLayout>
