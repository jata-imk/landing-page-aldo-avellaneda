---
import MainLayout from '../../layouts/MainLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import HeroSection from '../../components/sections/HeroSection.astro';
import AboutSection from '../../components/sections/AboutSection.astro';
import AppointmentSection from '../../components/sections/AppointmentSection.astro';
import GallerySection from '../../components/sections/GallerySection.astro';
import WhyChooseSection from '../../components/sections/WhyChooseSection.astro';
import TestimonialsSection from '../../components/sections/TestimonialsSection.astro';
import MapSection from '../../components/sections/MapSection.astro';

const title = 'Dr. José Aldo Avellaneda - Spine Surgery Specialist | Mérida, Yucatán';
const description = 'Highly specialized spine surgeon expert in complex procedures and minimally invasive techniques. Serving patients from Mexico, U.S., and Canada in Mérida, Yucatán.';
const lang = 'en';
---

<MainLayout {title} {description} {lang} ogImage="/hero-img.png">
  <div class="st-content">
    <Header {lang} isHomepage={true} />

    <main>
      <HeroSection {lang} />
      <AboutSection {lang} />
      <AppointmentSection {lang} />
      <GallerySection {lang} />
      <WhyChooseSection {lang} />
      <TestimonialsSection {lang} />
    </main>

    <MapSection {lang} />
    <Footer {lang} />
  </div>
</MainLayout>
